# CityPulse Frontend Environment Variables (.env)
# Replace these with your project's actual configuration.

# 1. Supabase API Configuration (Found in Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Web Push VAPID Public Key
# Generated via: npx web-push generate-vapid-keys
# CRITICAL: Only the PUBLIC key is placed here. Never expose the private key to the frontend!
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# -----------------------------------------------------------------------------
# BACKEND SECRETS (Do NOT put these in frontend .env; set via Supabase Dashboard / CLI secrets):
#
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# VAPID_PUBLIC_KEY=your-vapid-public-key-here
# VAPID_PRIVATE_KEY=your-vapid-private-key-here
# VAPID_SUBJECT=mailto:admin@yourcitypulse.org
# -----------------------------------------------------------------------------
